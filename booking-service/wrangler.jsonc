{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystaleye-bookings",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "vars": {"SITE_ORIGIN": "https://robbiecalvin.github.io"},
  "d1_databases": [{"binding": "DB", "database_name": "crystaleye-bookings", "database_id": "REPLACE_WITH_D1_DATABASE_ID"}]
}
